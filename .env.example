# ====================================================================
# CLINORA - VARIÁVEIS DE AMBIENTE (VERCEL, SUPABASE, GEMINI, MERCADO PAGO)
# ====================================================================

# 1. URL DA APLICAÇÃO (Vercel / Domínio Próprio)
# Na Vercel, a variável VERCEL_URL é disponibilizada automaticamente.
# Você também pode definir explicitamente o domínio de produção:
APP_URL="https://seu-app.vercel.app"
SITE_URL="https://seu-app.vercel.app"
VITE_SITE_URL="https://seu-app.vercel.app"

# 2. GEMINI AI (Servidor / Vercel Functions)
# Chave da API do Google Gemini para geração de propostas e follow-ups
GEMINI_API_KEY=""

# 3. SUPABASE (Auth + Banco de Dados PostgreSQL)
# URL e chave pública (acessíveis pelo frontend e backend)
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Chave de Serviço do Supabase (Apenas Servidor / Vercel Functions - NUNCA expor no frontend)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# 4. MERCADO PAGO (Checkout Pro + Webhooks)
# Chave pública para o frontend
VITE_MERCADOPAGO_PUBLIC_KEY="APP_USR-sua-chave-publica"

# Access Token e Webhook Secret (Apenas Servidor / Vercel Functions)
MERCADOPAGO_ACCESS_TOKEN="APP_USR-seu-access-token"
MERCADOPAGO_WEBHOOK_SECRET="seu-webhook-secret-opcional"
