# Clinora Environment Variables

# APP_URL: The public URL of the application.
APP_URL="http://localhost:3000"

# SUPABASE: Configuration for Supabase Auth and Database
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# MERCADO PAGO: Integration for recurring subscriptions
MERCADOPAGO_PUBLIC_KEY="APP_USR-your-public-key"
MERCADOPAGO_ACCESS_TOKEN="APP_USR-your-access-token"
MERCADOPAGO_WEBHOOK_SECRET="your-webhook-secret"

